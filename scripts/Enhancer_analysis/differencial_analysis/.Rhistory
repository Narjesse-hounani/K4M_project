## Intersect H3K4me1-H3K27me3 with enhancers
result_H3K4me1_H3K27me3_enhancer <- get_overlap_mark2_enhancer(result_H3K4me1_H3K27me3, mark2_name = "H3K4me1")
rm(result_H3K4me1_H3K27me3)
clean_NoDiff <- function(df, colname) {
df[[colname]][df[[colname]] == "NaN"] <- "n.s."
return(df)
}
df_RNA <- read.table("/Users/maxim/Documents/RNAseq_2i_to_EpiLC/RNAseq_data_Angelique/H3K4M_RNAseq_RPKM_without_dup_WT.H3K4M.D2_vs_WT.H3.D2.txt", header = TRUE)
## Clean table (remove condition tags)
colnames(df_RNA) <- str_remove(colnames(df_RNA), "_[[:alnum:].]+_vs_[[:alnum:].]+$")
df_RNA <- df_RNA %>% dplyr::rename(LogFC_RNA = logFC)
## Clean DE tags
df_RNA$thresh_adjp005_fc1 <- str_remove(df_RNA$thresh_adjp005_fc1, "_[[:alnum:].]+_vs_[[:alnum:].]+$")
df_RNA <- clean_NoDiff(df_RNA, "thresh_adjp005_fc1")
## Add RNAseq information; drop non-quantified genes
## Enhancers
result_H3K4me1_H3K27me3_enhancer <- result_H3K4me1_H3K27me3_enhancer %>%
left_join(df_RNA, by = "Gene") %>%
filter(!is.na(LogFC_RNA))
p <- ggplot(result_H3K4me1_H3K27me3_enhancer, aes(x = LogFC_H3K27me3, y = LogFC_H3K4me1, colour = LogFC_RNA)) +
geom_point(alpha = 0.5) +
geom_hline(yintercept = 0) +
geom_vline(xintercept = 0) +
scale_colour_gradient2(low = ("blue"),  high = ("red"), mid = "grey80", limits = c(-2, 2), oob = scales::squish) +
theme_minimal()
p
quadrants_RNA(data = result_H3K4me1_H3K27me3_enhancer, x.axis = LogFC_H3K27me3, y.axis = LogFC_H3K4me1, direction = thresh_adjp005_fc1)
